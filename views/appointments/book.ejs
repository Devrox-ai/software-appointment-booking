<%- include('../partials/header') %>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Book a Software Consultation</h1>
      <p>Schedule a 1-on-1 strategy meeting with our engineering team on a single seamless page</p>
    </div>
  </section>

  <!-- Single Continuous Booking Page Section -->
  <section class="section" id="bookingSinglePageSection">
    <div class="container" id="bookingPageContainer" style="max-width: 960px;">
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" id="serverErrorMessage" style="margin-bottom: 2rem;"><%= error %></div>
      <% } %>

      <% const hasPreselectedService = (typeof selectedServiceDoc !== 'undefined' && selectedServiceDoc) || (typeof selectedService !== 'undefined' && selectedService); %>

      <!-- SELECTED SERVICE TOP BANNER (Shown directly when service is preselected via URL or button) -->
      <div class="selected-service-header-banner card" id="selectedServiceTopBanner"
           style="<%= hasPreselectedService ? 'display: block;' : 'display: none;' %> background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%); border: 2px solid #3b82f6; padding: 1.25rem 1.5rem; border-radius: var(--radius-md); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="font-size: 2.2rem; line-height: 1;" id="topBannerServiceIcon">
              <%= selectedServiceDoc ? (selectedServiceDoc.icon || '&#128736;') : '&#128736;' %>
            </div>
            <div>
              <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #1e40af; display: block; margin-bottom: 2px;">&#10003; SELECTED SERVICE</span>
              <h2 style="font-size: 1.45rem; color: #1e3a8a; margin: 0; font-weight: 700;" id="topBannerServiceName">
                <%= selectedServiceDoc ? selectedServiceDoc.name : 'Selected Service' %>
              </h2>
              <p style="margin: 4px 0 0; font-size: 0.88rem; color: #4b5563;" id="topBannerServiceDesc">
                <%= selectedServiceDoc ? selectedServiceDoc.description : '' %>
              </p>
            </div>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" id="btnToggleChangeService" style="background: #ffffff; border: 1px solid #93c5fd; color: #1e40af; font-weight: 600; padding: 0.5rem 1rem;">
            &#9998; Change Service
          </button>
        </div>
      </div>

      <!-- Main Unified Form (All Sections on THE SAME PAGE) -->
      <form id="bookingForm" action="/book" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="serviceId" id="serviceId" value="<%= (typeof formData !== 'undefined' && formData.serviceId) || (typeof selectedService !== 'undefined' && selectedService ? selectedService : '') %>">
        <input type="hidden" name="appointmentDate" id="appointmentDate" value="<%= (typeof formData !== 'undefined' && formData.appointmentDate) || '' %>">
        <input type="hidden" name="appointmentTime" id="appointmentTime" value="<%= (typeof formData !== 'undefined' && formData.appointmentTime) || '' %>">
        <input type="hidden" name="customerPhone" id="customerPhone" value="<%= (typeof formData !== 'undefined' && formData.customerPhone) || '' %>">

        <!-- ============================================================== -->
        <!-- SECTION 1: SERVICE SELECTION                                   -->
        <!-- (Hidden when service is preselected via URL, shown if /book)   -->
        <!-- ============================================================== -->
        <div class="booking-section-block" id="sectionServiceSelection" style="<%= hasPreselectedService ? 'display: none;' : 'display: block;' %> margin-bottom: 2rem;">
          <div class="section-title-wrap" style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="step-circle-badge">1</span>
              <div>
                <h2 style="font-size: 1.35rem; margin: 0; color: var(--navy);">Select a Software Service</h2>
                <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">Choose a service below to open the customer details form directly underneath.</p>
              </div>
            </div>
          </div>

          <div class="grid-3 service-selection-grid">
            <% if (services && services.length > 0) { %>
              <% services.forEach(function(service) { 
                   const isPreSelected = (typeof formData !== 'undefined' && formData.serviceId && formData.serviceId.toString() === service._id.toString()) ||
                                         (typeof selectedService !== 'undefined' && selectedService && selectedService.toString() === service._id.toString());
              %>
                <div class="service-card card service-selectable <%= isPreSelected ? 'selected' : '' %>"
                     data-service-id="<%= service._id %>"
                     data-service-name="<%= service.name %>"
                     data-service-desc="<%= service.description || '' %>"
                     data-service-icon="<%= service.icon || '&#128736;' %>">
                  <div class="service-card-icon"><%= service.icon || '&#128736;' %></div>
                  <h3 class="service-card-title"><%= service.name %></h3>
                  <p class="service-card-desc"><%= service.description %></p>
                  <div class="service-card-footer">
                    <span class="service-select-btn">&#10010; Click to Select</span>
                    <div class="service-check">&#10003; Selected</div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                <p>No software services are currently available for booking. Please contact support.</p>
              </div>
            <% } %>
          </div>
          <span class="field-error-msg" id="errServiceSelection" style="margin-top: 8px;"></span>
        </div>

        <!-- ============================================================== -->
        <!-- SECTION 2: CUSTOMER DETAILS                                    -->
        <!-- (Directly visible when service is preselected or selected)     -->
        <!-- ============================================================== -->
        <div class="booking-section-block" id="sectionCustomerDetails" style="<%= hasPreselectedService ? 'display: block;' : 'display: none;' %> margin-bottom: 2.5rem;">
          <div class="section-title-wrap" style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span class="step-circle-badge">2</span>
                <div>
                  <h2 style="font-size: 1.35rem; margin: 0; color: var(--navy);">Customer Details Form</h2>
                  <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">Please enter your contact details and requirements for this consultation.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="booking-form-card card" style="padding: 1.75rem;">
            <div class="grid-2">
              <!-- Full Name -->
              <div class="form-group">
                <label for="customerName" class="form-label">Full Name <span class="required">*</span></label>
                <input type="text"
                       id="customerName"
                       name="customerName"
                       class="form-input"
                       placeholder="e.g. John Doe"
                       required
                       autocomplete="name"
                       value="<%= (typeof formData !== 'undefined' && formData.customerName) || '' %>">
                <span class="field-error-msg" id="errCustomerName"></span>
              </div>

              <!-- Email Address -->
              <div class="form-group">
                <label for="customerEmail" class="form-label">Email Address <span class="required">*</span></label>
                <input type="email"
                       id="customerEmail"
                       name="customerEmail"
                       class="form-input"
                       placeholder="e.g. john@example.com"
                       required
                       autocomplete="email"
                       value="<%= (typeof formData !== 'undefined' && formData.customerEmail) || '' %>">
                <span class="field-error-msg" id="errCustomerEmail"></span>
                <small class="text-muted" style="font-size: 0.8rem; display: block; margin-top: 4px;">Confirmation &amp; calendar invite will be delivered to this email.</small>
              </div>
            </div>

            <div class="grid-2">
              <!-- Country Code Dropdown + Phone Number -->
              <div class="form-group phone-group-container">
                <label for="phoneNumber" class="form-label">Phone Number <span class="required">*</span></label>
                <div class="phone-input-combo">
                  <div class="country-code-select-wrap">
                    <select id="countryCodeSelect" name="countryCode" class="form-select country-select" aria-label="Country Code">
                      <optgroup label="Popular Countries">
                        <option value="+91" data-flag="🇮🇳" data-name="India" selected>🇮🇳 India (+91)</option>
                        <option value="+1" data-flag="🇺🇸" data-name="United States">🇺🇸 United States (+1)</option>
                        <option value="+44" data-flag="🇬🇧" data-name="United Kingdom">🇬🇧 United Kingdom (+44)</option>
                        <option value="+1" data-flag="🇨🇦" data-name="Canada">🇨🇦 Canada (+1)</option>
                        <option value="+971" data-flag="🇦🇪" data-name="United Arab Emirates">🇦🇪 UAE (+971)</option>
                        <option value="+61" data-flag="🇦🇺" data-name="Australia">🇦🇺 Australia (+61)</option>
                        <option value="+65" data-flag="🇸🇬" data-name="Singapore">🇸🇬 Singapore (+65)</option>
                        <option value="+49" data-flag="🇩🇪" data-name="Germany">🇩🇪 Germany (+49)</option>
                        <option value="+966" data-flag="🇸🇦" data-name="Saudi Arabia">🇸🇦 Saudi Arabia (+966)</option>
                        <option value="+974" data-flag="🇶🇦" data-name="Qatar">🇶🇦 Qatar (+974)</option>
                        <option value="+965" data-flag="🇰🇼" data-name="Kuwait">🇰🇼 Kuwait (+965)</option>
                        <option value="+968" data-flag="🇴🇲" data-name="Oman">🇴🇲 Oman (+968)</option>
                        <option value="+973" data-flag="🇧🇭" data-name="Bahrain">🇧🇭 Bahrain (+973)</option>
                        <option value="+64" data-flag="🇳🇿" data-name="New Zealand">🇳🇿 New Zealand (+64)</option>
                      </optgroup>
                      <optgroup label="All Countries (A - Z)">
                        <option value="+93" data-flag="🇦🇫" data-name="Afghanistan">🇦🇫 Afghanistan (+93)</option>
                        <option value="+355" data-flag="🇦🇱" data-name="Albania">🇦🇱 Albania (+355)</option>
                        <option value="+213" data-flag="🇩🇿" data-name="Algeria">🇩🇿 Algeria (+213)</option>
                        <option value="+54" data-flag="🇦🇷" data-name="Argentina">🇦🇷 Argentina (+54)</option>
                        <option value="+374" data-flag="🇦🇲" data-name="Armenia">🇦🇲 Armenia (+374)</option>
                        <option value="+43" data-flag="🇦🇹" data-name="Austria">🇦🇹 Austria (+43)</option>
                        <option value="+994" data-flag="🇦🇿" data-name="Azerbaijan">🇦🇿 Azerbaijan (+994)</option>
                        <option value="+880" data-flag="🇧🇩" data-name="Bangladesh">🇧🇩 Bangladesh (+880)</option>
                        <option value="+32" data-flag="🇧🇪" data-name="Belgium">🇧🇪 Belgium (+32)</option>
                        <option value="+55" data-flag="🇧🇷" data-name="Brazil">🇧🇷 Brazil (+55)</option>
                        <option value="+359" data-flag="🇧🇬" data-name="Bulgaria">🇧🇬 Bulgaria (+359)</option>
                        <option value="+56" data-flag="🇨🇱" data-name="Chile">🇨🇱 Chile (+56)</option>
                        <option value="+86" data-flag="🇨🇳" data-name="China">🇨🇳 China (+86)</option>
                        <option value="+57" data-flag="🇨🇴" data-name="Colombia">🇨🇴 Colombia (+57)</option>
                        <option value="+385" data-flag="🇭🇷" data-name="Croatia">🇭🇷 Croatia (+385)</option>
                        <option value="+357" data-flag="🇨🇾" data-name="Cyprus">🇨🇾 Cyprus (+357)</option>
                        <option value="+420" data-flag="🇨🇿" data-name="Czech Republic">🇨🇿 Czech Republic (+420)</option>
                        <option value="+45" data-flag="🇩🇰" data-name="Denmark">🇩🇰 Denmark (+45)</option>
                        <option value="+20" data-flag="🇪🇬" data-name="Egypt">🇪🇬 Egypt (+20)</option>
                        <option value="+372" data-flag="🇪🇪" data-name="Estonia">🇪🇪 Estonia (+372)</option>
                        <option value="+358" data-flag="🇫🇮" data-name="Finland">🇫🇮 Finland (+358)</option>
                        <option value="+33" data-flag="🇫🇷" data-name="France">🇫🇷 France (+33)</option>
                        <option value="+995" data-flag="🇬🇪" data-name="Georgia">🇬🇪 Georgia (+995)</option>
                        <option value="+30" data-flag="🇬🇷" data-name="Greece">🇬🇷 Greece (+30)</option>
                        <option value="+852" data-flag="🇭🇰" data-name="Hong Kong">🇭🇰 Hong Kong (+852)</option>
                        <option value="+36" data-flag="🇭🇺" data-name="Hungary">🇭🇺 Hungary (+36)</option>
                        <option value="+354" data-flag="🇮🇸" data-name="Iceland">🇮🇸 Iceland (+354)</option>
                        <option value="+62" data-flag="🇮🇩" data-name="Indonesia">🇮🇩 Indonesia (+62)</option>
                        <option value="+353" data-flag="🇮🇪" data-name="Ireland">🇮🇪 Ireland (+353)</option>
                        <option value="+972" data-flag="🇮🇱" data-name="Israel">🇮🇱 Israel (+972)</option>
                        <option value="+39" data-flag="🇮🇹" data-name="Italy">🇮🇹 Italy (+39)</option>
                        <option value="+81" data-flag="🇯🇵" data-name="Japan">🇯🇵 Japan (+81)</option>
                        <option value="+962" data-flag="🇯🇴" data-name="Jordan">🇯🇴 Jordan (+962)</option>
                        <option value="+7" data-flag="🇰🇿" data-name="Kazakhstan">🇰🇿 Kazakhstan (+7)</option>
                        <option value="+254" data-flag="🇰🇪" data-name="Kenya">🇰🇪 Kenya (+254)</option>
                        <option value="+82" data-flag="🇰🇷" data-name="South Korea">🇰🇷 South Korea (+82)</option>
                        <option value="+961" data-flag="🇱🇧" data-name="Lebanon">🇱🇧 Lebanon (+961)</option>
                        <option value="+60" data-flag="🇲🇾" data-name="Malaysia">🇲🇾 Malaysia (+60)</option>
                        <option value="+230" data-flag="🇲🇺" data-name="Mauritius">🇲🇺 Mauritius (+230)</option>
                        <option value="+52" data-flag="🇲🇽" data-name="Mexico">🇲🇽 Mexico (+52)</option>
                        <option value="+212" data-flag="🇲🇦" data-name="Morocco">🇲🇦 Morocco (+212)</option>
                        <option value="+977" data-flag="🇳🇵" data-name="Nepal">🇳🇵 Nepal (+977)</option>
                        <option value="+31" data-flag="🇳🇱" data-name="Netherlands">🇳🇱 Netherlands (+31)</option>
                        <option value="+234" data-flag="🇳🇬" data-name="Nigeria">🇳🇬 Nigeria (+234)</option>
                        <option value="+47" data-flag="🇳🇴" data-name="Norway">🇳🇴 Norway (+47)</option>
                        <option value="+92" data-flag="🇵🇰" data-name="Pakistan">🇵🇰 Pakistan (+92)</option>
                        <option value="+63" data-flag="🇵🇭" data-name="Philippines">🇵🇭 Philippines (+63)</option>
                        <option value="+48" data-flag="🇵🇱" data-name="Poland">🇵🇱 Poland (+48)</option>
                        <option value="+351" data-flag="🇵🇹" data-name="Portugal">🇵🇹 Portugal (+351)</option>
                        <option value="+40" data-flag="🇷🇴" data-name="Romania">🇷🇴 Romania (+40)</option>
                        <option value="+27" data-flag="🇿🇦" data-name="South Africa">🇿🇦 South Africa (+27)</option>
                        <option value="+34" data-flag="🇪🇸" data-name="Spain">🇪🇸 Spain (+34)</option>
                        <option value="+94" data-flag="🇱🇰" data-name="Sri Lanka">🇱🇰 Sri Lanka (+94)</option>
                        <option value="+46" data-flag="🇸🇪" data-name="Sweden">🇸🇪 Sweden (+46)</option>
                        <option value="+41" data-flag="🇨🇭" data-name="Switzerland">🇨🇭 Switzerland (+41)</option>
                        <option value="+886" data-flag="🇹🇼" data-name="Taiwan">🇹🇼 Taiwan (+886)</option>
                        <option value="+66" data-flag="🇹🇭" data-name="Thailand">🇹🇭 Thailand (+66)</option>
                        <option value="+90" data-flag="🇹🇷" data-name="Turkey">🇹🇷 Turkey (+90)</option>
                        <option value="+380" data-flag="🇺🇦" data-name="Ukraine">🇺🇦 Ukraine (+380)</option>
                        <option value="+84" data-flag="🇻🇳" data-name="Vietnam">🇻🇳 Vietnam (+84)</option>
                      </optgroup>
                    </select>
                  </div>
                  <div class="phone-number-wrap">
                    <input type="tel"
                           id="phoneNumber"
                           name="phoneNumber"
                           class="form-input"
                           placeholder="98765 43210"
                           required
                           autocomplete="tel-national"
                           inputmode="tel"
                           value="<%= (typeof formData !== 'undefined' && formData.phoneNumber) || '' %>">
                  </div>
                </div>
                <span class="field-error-msg" id="errCustomerPhone"></span>
              </div>

              <!-- Company Name (Optional) -->
              <div class="form-group">
                <label for="customerCompany" class="form-label">Company / Organization <span class="optional">(Optional)</span></label>
                <input type="text"
                       id="customerCompany"
                       name="customerCompany"
                       class="form-input"
                       placeholder="e.g. Acme Tech Solutions"
                       autocomplete="organization"
                       value="<%= (typeof formData !== 'undefined' && formData.customerCompany) || '' %>">
              </div>
            </div>

            <!-- Project Requirements -->
            <div class="form-group">
              <label for="projectDescription" class="form-label">Project Requirements &amp; Goals <span class="required">*</span></label>
              <textarea id="projectDescription"
                        name="projectDescription"
                        class="form-textarea"
                        rows="4"
                        placeholder="Briefly describe what you are looking to build, technical preferences, or key consultation objectives..."
                        required><%= (typeof formData !== 'undefined' && formData.projectDescription) || '' %></textarea>
              <span class="field-error-msg" id="errProjectDescription"></span>
            </div>

            <!-- Action Button to Unlock Schedule on Same Page -->
            <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
              <button type="button" class="btn btn-primary btn-lg" id="btnContinueToDateTime">
                Continue to Date &amp; Time Selection &darr;
              </button>
            </div>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- SECTION 3: DATE & TIME (CONTINUOUS ON SAME PAGE)               -->
        <!-- ============================================================== -->
        <div class="booking-section-block" id="sectionDateTime" style="margin-top: 2.5rem; display: none;">
          <div class="section-title-wrap" style="margin-bottom: 1.25rem; padding-top: 1.5rem; border-top: 2px dashed #e2e8f0;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span class="step-circle-badge">3</span>
                <div>
                  <h2 style="font-size: 1.35rem; margin: 0; color: var(--navy);">Select Appointment Date &amp; Time</h2>
                  <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">Choose a convenient date on the calendar, then pick from the live available slots.</p>
                </div>
              </div>
              <span id="selectedDateDisplayBadge" class="badge badge-accepted" style="display: none;">Date Selected</span>
            </div>
          </div>

          <div class="grid-2 schedule-grid">
            <!-- Calendar Card -->
            <div class="card calendar-card" style="padding: 1.5rem;">
              <div class="calendar-card-header">
                <h3 class="calendar-heading">Calendar</h3>
                <span class="timezone-badge">&#128337; Asia/Kolkata (IST)</span>
              </div>
              <div id="datePickerCalendar" class="calendar-grid-wrap">
                <!-- Dynamically rendered by single-page booking script -->
              </div>
              <div class="calendar-legend">
                <span class="legend-item"><span class="legend-dot dot-available"></span> Available</span>
                <span class="legend-item"><span class="legend-dot dot-selected"></span> Selected</span>
                <span class="legend-item"><span class="legend-dot dot-disabled"></span> Unavailable</span>
              </div>
            </div>

            <!-- Time Slots Card -->
            <div class="card time-slots-card" style="padding: 1.5rem;">
              <div class="time-slots-header">
                <h3 class="time-slots-heading">Available Slots</h3>
                <small class="text-muted" id="slotStatusHint">Click a date first</small>
              </div>
              <div id="timeSlotsContainer" class="time-slots-wrapper">
                <div class="time-slots-placeholder">
                  <span class="placeholder-icon">&#128197;</span>
                  <p>Please click an available date on the calendar to view real-time 30-minute consultation slots.</p>
                </div>
              </div>
              <span class="field-error-msg" id="errAppointmentSlot" style="margin-top: 10px; display: block;"></span>
            </div>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- SECTION 4: REVIEW & CONFIRM (SAME PAGE SUMMARY)                -->
        <!-- ============================================================== -->
        <div class="booking-section-block" id="sectionReview" style="margin-top: 2.5rem; display: none;">
          <div class="section-title-wrap" style="margin-bottom: 1.25rem; padding-top: 1.5rem; border-top: 2px dashed #e2e8f0;">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="step-circle-badge">4</span>
              <div>
                <h2 style="font-size: 1.35rem; margin: 0; color: var(--navy);">Review &amp; Confirm Booking</h2>
                <p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">Verify your details below. You can scroll up and edit any section at any time without losing data.</p>
              </div>
            </div>
          </div>

          <div class="card booking-summary-card" style="padding: 1.75rem;">
            <!-- Service Summary -->
            <div class="review-section">
              <div class="review-section-header">
                <h4><span class="review-icon">&#128736;</span> Selected Service</h4>
                <button type="button" class="btn-text-edit" id="btnEditService">&#9998; Change Service</button>
              </div>
              <div class="review-section-content">
                <strong id="summaryService" class="review-highlight" style="font-size: 1.1rem; color: #1e40af;">—</strong>
              </div>
            </div>

            <div class="review-divider"></div>

            <!-- Customer Details Summary -->
            <div class="review-section">
              <div class="review-section-header">
                <h4><span class="review-icon">&#128100;</span> Customer &amp; Contact Details</h4>
                <button type="button" class="btn-text-edit" id="btnEditDetails">&#9998; Edit Details</button>
              </div>
              <div class="review-grid">
                <div class="review-item">
                  <span class="review-label">Full Name</span>
                  <strong class="review-val" id="summaryName">—</strong>
                </div>
                <div class="review-item">
                  <span class="review-label">Email Address</span>
                  <strong class="review-val" id="summaryEmail">—</strong>
                </div>
                <div class="review-item">
                  <span class="review-label">Phone Number</span>
                  <strong class="review-val" id="summaryPhone">—</strong>
                </div>
                <div class="review-item">
                  <span class="review-label">Company / Org</span>
                  <strong class="review-val" id="summaryCompany">—</strong>
                </div>
              </div>
            </div>

            <div class="review-divider"></div>

            <!-- Schedule Summary -->
            <div class="review-section">
              <div class="review-section-header">
                <h4><span class="review-icon">&#128197;</span> Appointment Schedule</h4>
                <button type="button" class="btn-text-edit" id="btnEditSchedule">&#9998; Change Date &amp; Time</button>
              </div>
              <div class="review-schedule-box">
                <div class="schedule-date-box">
                  <span class="review-label">Date</span>
                  <strong class="review-highlight" id="summaryDate">—</strong>
                </div>
                <div class="schedule-time-box">
                  <span class="review-label">Time (IST)</span>
                  <strong class="review-highlight" id="summaryTime">—</strong>
                </div>
              </div>
            </div>

            <div class="review-divider"></div>

            <!-- Project Requirements Summary -->
            <div class="review-section">
              <div class="review-section-header">
                <h4><span class="review-icon">&#128221;</span> Project Requirements</h4>
              </div>
              <p class="review-description-text" id="summaryDescription" style="white-space: pre-wrap; color: var(--text-main); margin: 0;">—</p>
            </div>
          </div>

          <!-- Guarantee & Email Notice -->
          <div class="booking-guarantee-note" style="margin-top: 1.25rem;">
            <span class="guarantee-icon">&#128274;</span>
            <p>Your booking will be recorded in MongoDB with status <strong>Pending</strong>, and notification emails will be dispatched automatically via Google Gmail API OAuth 2.0 to your submitted email address and our admin team.</p>
          </div>

          <!-- Submit Button -->
          <div style="margin-top: 1.5rem; text-align: right;">
            <button type="submit" class="btn btn-primary btn-lg btn-submit" id="btnSubmitBooking" style="padding: 0.85rem 2rem; font-size: 1.05rem;">
              <span class="btn-text">&#10003; Confirm &amp; Submit Booking</span>
              <span class="btn-spinner" style="display: none;">Submitting your booking...</span>
            </button>
          </div>
        </div>

      </form>
    </div>
  </section>

