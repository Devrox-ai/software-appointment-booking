<%- include('partials/header') %>

  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>About Us</h1>
      <p>Learn more about our mission, values, and the team behind your success</p>
    </div>
  </section>

  <!-- Company Story -->
  <section class="section">
    <div class="container">
      <div class="about-story">
        <div class="about-story-content">
          <h2 class="section-title">Our Story</h2>
          <p>Founded with a passion for technology and innovation, <%= settings.companyName %> has grown from a small team of dedicated developers into a full-service software consultancy trusted by businesses worldwide.</p>
          <p>We believe that great software starts with a conversation. That's why we've built our entire process around understanding your unique challenges and delivering solutions that genuinely move your business forward. Every project begins with a personal consultation where we listen, learn, and plan together.</p>
          <p>Over the years, we've helped dozens of companies—from ambitious startups to established enterprises—transform their ideas into powerful digital products that delight users and drive measurable results.</p>
        </div>
        <div class="about-story-visual">
          <div class="about-shape">
            <span class="about-icon">&#127968;</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section section-alt">
    <div class="container">
      <div class="grid-2">
        <div class="card mission-card">
          <div class="mission-icon">&#127919;</div>
          <h3>Our Mission</h3>
          <p>To empower businesses with innovative, reliable, and scalable software solutions. We strive to make technology accessible by providing world-class consultation and development services that turn complex challenges into elegant, user-friendly products.</p>
        </div>
        <div class="card mission-card">
          <div class="mission-icon">&#128065;</div>
          <h3>Our Vision</h3>
          <p>To be the most trusted software consultancy, recognized for our commitment to quality, transparency, and client success. We envision a world where every business, regardless of size, has access to technology that helps them thrive and compete.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Our Core Values</h2>
        <p class="section-subtitle">The principles that guide everything we do</p>
      </div>
      <div class="grid-4">
        <div class="card value-card">
          <div class="value-icon">&#128161;</div>
          <h4>Innovation</h4>
          <p>We embrace new technologies and creative thinking to deliver cutting-edge solutions that keep you ahead of the curve.</p>
        </div>
        <div class="card value-card">
          <div class="value-icon">&#129309;</div>
          <h4>Integrity</h4>
          <p>Honesty and transparency are the foundation of every client relationship. We communicate openly and deliver on our promises.</p>
        </div>
        <div class="card value-card">
          <div class="value-icon">&#9889;</div>
          <h4>Excellence</h4>
          <p>We hold ourselves to the highest standards of quality in every line of code, every design, and every interaction.</p>
        </div>
        <div class="card value-card">
          <div class="value-icon">&#128106;</div>
          <h4>Collaboration</h4>
          <p>We work alongside you as true partners, ensuring your voice shapes every decision and your goals drive every milestone.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Let's Build Something Great Together</h2>
        <p class="cta-subtitle">Book a free consultation and discover how we can bring your project to life.</p>
        <a href="/book" class="btn btn-primary btn-lg">Book a Consultation</a>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
