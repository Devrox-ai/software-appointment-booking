<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= settings.companyName %> - Professional Software Consultation & Development Services">
  <title><%= title %> | <%= settings.companyName %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2">
  <link rel="apple-touch-icon" href="/images/logo-icon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <% if (currentPath && currentPath.startsWith('/admin')) { %>
  <link rel="stylesheet" href="/css/admin.css">
  <% } %>
</head>
<body>
  <nav class="nav">
    <div class="container">
      <a href="/" class="nav-brand">
        <img src="/images/logo-icon.svg?v=2" alt="<%= settings.companyName %> Logo" width="34" height="34" class="nav-brand-logo">
        <span class="nav-brand-text"><%= settings.companyName %></span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="nav-links" id="navLinks">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
        <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
        <a href="/services" class="<%= currentPath === '/services' ? 'active' : '' %>">Services</a>
        <a href="/book" class="<%= currentPath === '/book' ? 'active' : '' %>">Book Appointment</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
        <a href="/book" class="btn btn-primary nav-cta">Book Consultation</a>
      </div>
    </div>
  </nav>
